# Local database (PGlite file path; swap for real Postgres when deploying)
DATABASE_PATH=./.data/tsunagu

# Auth.js
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Corsair (required for connectors and everything Google-facing)
# Provision tables + integration credentials once per database: npm run corsair:setup
DATABASE_URL=
# Neon direct URL — pulled by `neon deploy`; migrations/DDL must use this, not the pooler
DATABASE_URL_UNPOOLED=
CORSAIR_KEK=
CORSAIR_HUB_PROJECT_API_KEY=
CORSAIR_HUB_SIGNING_SECRET=

# Public base URL of the app; Hub sends the user back to APP_URL/connector after OAuth
APP_URL=http://localhost:3000

# LLM for Chat (OpenAI-compatible endpoint); without these, only Chat fails
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=agnes-3-flash
